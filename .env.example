# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Agrimatco Smart Crop Advisor
NEXT_PUBLIC_APP_DESCRIPTION=AI-powered agricultural assistant

# Backend
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development

# Database
DATABASE_URL=postgresql://agrimatco:agrimatco_password@localhost:5432/agrimatco_db
DATABASE_ECHO=true

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4-vision
OPENAI_VISION_MODEL=gpt-4-turbo-with-vision

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_EXPIRATION=3600

# Vector Database (Pinecone or Weaviate)
VECTOR_DB_TYPE=pinecone
PINCECONE_API_KEY=your-pinecone-api-key
PINCECONE_INDEX_NAME=agrimatco-products
PINCECONE_ENVIRONMENT=production

# Or for Weaviate
# WEAVIATE_URL=http://localhost:8080
# WEAVIATE_GRPC_URL=localhost:50051

# AWS (Optional - for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=agrimatco-uploads

# Blob Storage (Azure or alternative)
BLOB_STORAGE_TYPE=local
# BLOB_STORAGE_TYPE=azure
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=
# AZURE_CONTAINER_NAME=agrimatco-images

# File Upload
MAX_UPLOAD_SIZE=52428800  # 50MB
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,webp,gif
UPLOAD_DIR=./uploads

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@agrimatco.com
SMTP_FROM_NAME=Agrimatco Smart Crop Advisor

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring
SENTRY_DSN=

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOW_HEADERS=Content-Type,Authorization

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Admin Defaults
ADMIN_EMAIL=admin@agrimatco.com
ADMIN_PASSWORD=Admin@123456

# Internationalization
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ar

# Feature Flags
FEATURE_PDF_EXPORT=true
FEATURE_CHAT_ASSISTANT=true
FEATURE_PRODUCT_RECOMMENDATIONS=true
FEATURE_DARK_MODE=true

# Analytics
GOOGLE_ANALYTICS_ID=
MIXPANEL_TOKEN=
